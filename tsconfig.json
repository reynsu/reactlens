{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "dist",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "tsup.config.ts", "vitest.config.ts", "tests/unit/**/*", "tests/integration/**/*", "tests/diagnostic-eval/**/*.test.ts"],
  "exclude": ["node_modules", "dist", "tests/fixtures", "templates", "src/dashboard/web", "tests/diagnostic-eval/cases"]
}
