{
  "name": "reactlens",
  "version": "0.0.1",
  "description": "The first E2E testing tool that understands your React code, not just your DOM.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "reactlens": "./bin/reactlens.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:eval": "vitest run --project eval"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": []
  },
  "dependencies": {
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prompts": "^2.4.2",
    "zod": "^4.4.3"
  }
}
