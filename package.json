{
  "name": "@reynsu/reactlens",
  "version": "0.1.0",
  "description": "The first E2E testing tool that understands your React code, not just your DOM.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "reactlens": "bin/reactlens.js"
  },
  "exports": {
    ".": {
      "default": "./dist/cli.js"
    },
    "./config": {
      "types": "./dist/config/schema.d.ts",
      "import": "./dist/config/schema.mjs",
      "require": "./dist/config/schema.js"
    },
    "./component-object": {
      "types": "./dist/component-object/snapshot-accessor.d.ts",
      "import": "./dist/component-object/snapshot-accessor.mjs",
      "require": "./dist/component-object/snapshot-accessor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "src/generator/prompts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:eval": "vitest run --project eval",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": []
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.132",
    "@reynsu/reactlens-dashboard-ui": "^0.3.0",
    "@reynsu/reactlens-diagnosis-prompts": "^0.3.0",
    "@reynsu/reactlens-diff-core": "^0.1.0",
    "axe-core": "^4.11.4",
    "bippy": "^0.5.39",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prompts": "^2.4.2",
    "ts-morph": "^28.0.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  }
}
